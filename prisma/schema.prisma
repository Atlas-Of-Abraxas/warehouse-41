generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          String    @default("customer")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  orders        Order[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String
  price       Float
  category    String
  image       String      @default("/images/placeholder.jpg")
  stock       Int         @default(0)
  featured    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  orderItems  OrderItem[]
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  date        DateTime
  endDate     DateTime?
  type        String
  capacity    Int      @default(0)
  registered  Int      @default(0)
  price       Float    @default(0)
  image       String   @default("/images/placeholder.jpg")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Session {
  id             String    @id @default(cuid())
  title          String
  description    String
  gameSystem     String
  gmName         String
  date           DateTime
  duration       Int
  price          Float
  maxPlayers     Int
  currentPlayers Int       @default(0)
  image          String    @default("/images/placeholder.jpg")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  bookings       Booking[]
}

model Booking {
  id             String   @id @default(cuid())
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id])
  customerName   String
  customerEmail  String
  seats          Int      @default(1)
  paymentStatus  String   @default("pending")
  status         String   @default("confirmed")
  paidInStore    Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  customerName    String
  customerEmail   String
  total           Float
  status          String      @default("pending")
  /// Legacy name; optional external payment id (e.g. POS receipt) when not using Stripe.
  stripePaymentId String?
  /// In-store POS / external receipt reference.
  posReference    String?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model KillTeamBooking {
  id            String   @id @default(cuid())
  date          DateTime
  timeSlot      String
  terrain       String
  teams         String
  customerName  String
  customerEmail String
  status        String   @default("confirmed")
  paidInStore   Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MTGBooking {
  id            String   @id @default(cuid())
  date          DateTime
  timeSlot      String
  table         String?  // optional — time-slot-only booking
  format        String?  // optional — time-slot-only booking
  afterHours    Boolean  @default(false)
  customerName  String
  customerEmail String
  status        String   @default("confirmed")
  paidInStore   Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
