# --- Prisma / Postgres -------------------------------------------------
# Prefer DATABASE_URL. If you use Vercel’s Supabase integration, it may only set:
#   POSTGRES_PRISMA_URL (best for Prisma) or POSTGRES_URL — the app reads those as fallbacks.
#
# Local: direct db.*.supabase.co:5432 is OK. Vercel: use pooler (…pooler.supabase.com:6543) to avoid P1001.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres"
# If Node/pg fails with "self-signed certificate in certificate chain" on your machine (common behind SSL inspection), set for local dev only:
# SKIP_DB_SSL_VERIFY=1
# POSTGRES_PRISMA_URL=""
# POSTGRES_URL=""

# Local: http://localhost:3000 — Production (Vercel): https://your-project.vercel.app or your domain
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"

ADMIN_EMAIL="admin@warehouse41.com"
ADMIN_PASSWORD="changeme"

# Vercel AI Gateway — set in Vercel env for production; never commit real values
AI_GATEWAY_API_KEY=""

# Resend — booking confirmation emails (https://resend.com). If unset, sends are skipped (logged).
RESEND_API_KEY=""
# Optional: verified domain in Resend, e.g. "Warehouse 41 <bookings@yourdomain.com>". Default uses Resend dev sender.
# EMAIL_FROM=""

# Sentry — error monitoring (https://sentry.io). Public DSN; safe for NEXT_PUBLIC_. If unset, SDK stays disabled.
NEXT_PUBLIC_SENTRY_DSN=""

# Supabase (JS client / SSR). Publishable or legacy anon public key.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=""
